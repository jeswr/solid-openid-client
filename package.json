{
  "name": "@jeswr/solid-openid-client",
  "version": "0.1.0",
  "description": "Solid-OIDC engine wrapping panva's openid-client v6 — issuer discovery + authorization-code/PKCE + DPoP-bound tokens + refresh + a DPoP-attaching authed fetch, composing @jeswr/solid-dpop for RFC 9449 proofs. For Node/server apps (CLIs, services, bots, agents).",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeswr/solid-openid-client.git"
  },
  "homepage": "https://github.com/jeswr/solid-openid-client#readme",
  "bugs": {
    "url": "https://github.com/jeswr/solid-openid-client/issues"
  },
  "keywords": [
    "solid",
    "solid-oidc",
    "openid-client",
    "oidc",
    "dpop",
    "rfc9449",
    "oauth",
    "pkce",
    "authorization-code",
    "client-id-document"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openid-client": "^6.0.0"
  },
  "dependencies": {
    "@jeswr/solid-dpop": "github:jeswr/solid-dpop#7fbc739a129a5388940b65fcead6286d1ce19d8f",
    "jose": "^6.0.0"
  }
}
